{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RPG Maker Library",
  "version": "0.1.0",
  "identifier": "local.rpgmakerlibrary.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "title": "RPG Maker Library (prototipo)", "width": 1280, "height": 800, "minWidth": 800, "minHeight": 500 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"]
  }
}
